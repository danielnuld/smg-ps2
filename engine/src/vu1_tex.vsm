; VU1 microprogram: indexed batches, per-vertex matrix (skinning), transform, guard-band clip, perspective, STQ,
; colour per vertex. Written for this engine after ps2sdk's samples/draw/vu1/draw_3D.vsm (h4570, AFL 2.0): same xtop
; double buffering, clipw/fcand ADC trick and scale step. Untextured batches run the same code: their PRIM has
; TME = 0, so the GS ignores the ST it is given.
;
; VU mem 0      : scale (2048, 2048, 0xFFFFFF / 32), written once at init (outside the double buffers)
; VU mem 1..4   : the matrix of a static model instance (prebuilt chains, written after a FLUSHE)
; batch at TOP  : +0 int x = emitted vertex count ne, int y = 4 * matrix count m, int z = absolute matrix base (0: the
;                 m matrices that follow in the batch; 1: the static instance matrix at VU mem 1, then m = 0),
;                 int w = unique vertex count nu
;                 +1 GIF tag (PRE + PRIM, NLOOP = ne, regs ST, RGBAQ, XYZ2)
;                 +2 .. +2+4m-1      m matrices (local -> clip, 4 columns each)
;                 then nu positions (s32 x, y, z, w from UNPACK V4-16 signed: x, y, z in the model's quantisation
;                 step, which the matrices carry; w = 4 * matrix slot), nu UVs (s32 s, t, 12 fraction bits:
;                 UNPACK V2-16 signed; left unwritten if untextured), ne colours (u32 r, g, b, unique index: UNPACK
;                 V4-8 unsigned; the alpha 0x80 is put back here)
; output        : right after the colours: GIF tag, then ST (s/w, t/w, 1/w), RGBAQ, XYZ2 per vertex, XGKICKed.
;                 ST comes before RGBAQ so the GS takes Q from it (ps2sdk draw3d.h, DRAW_STQ2_REGLIST note).
; The matrices ride in the double buffer: a batch never reads a matrix the VIF is overwriting for the next one.
        .vu
        .align 4
        .global VU1Tex_CodeStart
        .global VU1Tex_CodeEnd
VU1Tex_CodeStart:
        NOP                                 lq.xyz        VF05,0(VI00)
        NOP                                 xtop          VI02
        NOP                                 fcset         0
        NOP                                 ilw.x         VI07,0(VI02)
        NOP                                 ilw.y         VI10,0(VI02)
        NOP                                 ilw.z         VI12,0(VI02)
        NOP                                 ilw.w         VI13,0(VI02)
        NOP                                 lq            VF06,1(VI02)
        NOP                                 iaddiu        VI11,VI02,2
        NOP                                 iadd          VI03,VI11,VI10
        NOP                                 ibeq          VI12,VI00,matInBatch
        NOP                                 NOP
        NOP                                 iadd          VI11,VI12,VI00
matInBatch:
        NOP                                 iadd          VI08,VI03,VI13
        NOP                                 iadd          VI04,VI08,VI13
        NOP                                 iadd          VI05,VI04,VI07
        NOP                                 iadd          VI06,VI05,VI00
        NOP                                 sqi           VF06,(VI06++)
        NOP                                 iadd          VI07,VI02,VI07
        NOP                                 iaddiu        VI10,VI00,0x80
vertexLoop:
        NOP                                 lq            VF08,0(VI04)
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 mtir          VI12,VF08w
        NOP                                 iadd          VI13,VI03,VI12
        NOP                                 iadd          VI12,VI08,VI12
        NOP                                 lq            VF07,0(VI13)
        NOP                                 lq            VF09,0(VI12)
        NOP                                 NOP
        NOP                                 NOP
        itof0.xyz     VF07,VF07             mtir          VI09,VF07w
        NOP                                 iadd          VI09,VI09,VI11
        NOP                                 lq            VF01,0(VI09)
        NOP                                 lq            VF02,1(VI09)
        NOP                                 lq            VF03,2(VI09)
        NOP                                 lq            VF04,3(VI09)
        NOP                                 mfir.w        VF08,VI10
        NOP                                 NOP
        mulax         ACC,VF01,VF07x        NOP
        madday        ACC,VF02,VF07y        NOP
        maddaz        ACC,VF03,VF07z        NOP
        maddw         VF07,VF04,VF00w       NOP
        itof12        VF09,VF09             NOP
        NOP                                 NOP
        NOP                                 NOP
        clipw.xyz     VF07xyz,VF07w         div           Q,VF00w,VF07w
        addw.z        VF09,VF00,VF00w       waitq
        mulq.xyz      VF07,VF07,Q           NOP
        mulq.xyz      VF09,VF09,Q           NOP
        NOP                                 NOP
        NOP                                 NOP
        mulaw.xyz     ACC,VF05,VF00w        NOP
        madd.xyz      VF07,VF07,VF05        NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        ftoi4.xyz     VF07,VF07             fcand         VI01,262143
        NOP                                 iaddiu        VI01,VI01,0x00007fff
        NOP                                 sq            VF09,0(VI06)
        NOP                                 sq            VF08,1(VI06)
        NOP                                 NOP
        NOP                                 sq.xyz        VF07,2(VI06)
        NOP                                 isw.w         VI01,2(VI06)
        NOP                                 iaddiu        VI04,VI04,1
        NOP                                 iaddiu        VI06,VI06,3
        NOP                                 isubiu        VI07,VI07,1
        NOP                                 ibne          VI07,VI02,vertexLoop
        NOP                                 NOP
        NOP                                 xgkick        VI05
        NOP[E]                              NOP
        NOP                                 NOP
        .align 4
VU1Tex_CodeEnd:
