; VU1 microprogram: indexed batches, per-vertex matrix (skinning), transform, guard-band clip, perspective, STQ,
; colour per vertex. Written for this engine after ps2sdk's samples/draw/vu1/draw_3D.vsm (h4570, AFL 2.0): same xtop
; double buffering, clipw/fcand ADC trick and scale step. Untextured batches run the same code: their PRIM has
; TME = 0, so the GS ignores the ST it is given.
;
; VU mem 0      : scale (2048, 2048, 0xFFFFFF / 32), written once at init (outside the double buffers)
; VU mem 1..7   : the matrix of a static model instance (prebuilt chains, written after a FLUSHE): 4 columns
;                 local -> clip, then its light matrix (3 columns, x: light 0, y: light 1, of the light directions in
;                 the local space x 1 / 127; lit batches only)
; VU mem 8..10  : UV matrix, columns s, t, 1 (identity; a BTK group's own around its batches, anim_btk)
; VU mem 11..14 : light 0 colour, light 1 colour, ambient (x 2 / 255: the channel's 0..1 doubled), (2, 2, 2, 255)
;                 (render_light)
; VU mem 16..   : the double buffers (496 qwords each)
; batch at TOP  : +0 int x = emitted vertex count ne, int y = 7 * matrix count m, int z = absolute matrix base (0: the
;                 m matrices that follow in the batch; 1: the static instance matrix at VU mem 1, then m = 0),
;                 int w = unique vertex count nu
;                 +1 GIF tag (PRE + PRIM, NLOOP = ne, regs ST, RGBAQ, XYZ2)
;                 +2 .. +2+7m-1      m matrices (local -> clip, 4 columns each, then the light matrix's 3)
;                 then nu positions (s32 x, y, z, w from UNPACK V4-16 signed: x, y, z in the model's quantisation
;                 step, which the matrices carry; w = 7 * matrix slot), nu UVs (s32 s, t, 12 fraction bits:
;                 UNPACK V2-16 signed; left unwritten if untextured), lit batches nu normals (s32 x, y, z x 127:
;                 UNPACK V4-8 signed), ne colours (u32 r, g, b, unique index: UNPACK V4-8 unsigned; the alpha 0x80
;                 is put back here)
; output        : right after the colours: GIF tag, then ST (s/w, t/w, 1/w), RGBAQ, XYZ2 per vertex, XGKICKed.
;                 ST comes before RGBAQ so the GS takes Q from it (ps2sdk draw3d.h, DRAW_STQ2_REGLIST note).
; Lit batches start at VU1Lit (render.c): GX's lit channel, colour x clamp(ambient + sum max(0, n . l) colour) x 2
; (the colours are stored x gain / 2: tools/slice.py vu_groups).
; Environment-mapped batches start at VU1Env (render.c): laid out as lit ones (their UVs unused), unlit; each normal
; through the clip matrix's columns, then the group's texgen matrix (VU mem 8..10 columns, 15 its constant: render_env)
; gives s, t, q, and STQ = (s, t, q) / w (q in Q: the GS divides, as GX does for a 3x4 texgen).
; The matrices ride in the double buffer: a batch never reads a matrix the VIF is overwriting for the next one.
        .vu
        .align 4
        .global VU1Tex_CodeStart
        .global VU1Tex_CodeEnd
        .global VU1Lit_Start
        .global VU1Env_Start
VU1Tex_CodeStart:
        NOP                                 lq.xyz        VF05,0(VI00)
        NOP                                 lq            VF10,8(VI00)
        NOP                                 lq            VF11,9(VI00)
        NOP                                 lq            VF12,10(VI00)
        NOP                                 xtop          VI02
        NOP                                 fcset         0
        NOP                                 ilw.x         VI07,0(VI02)
        NOP                                 ilw.y         VI10,0(VI02)
        NOP                                 ilw.z         VI12,0(VI02)
        NOP                                 ilw.w         VI13,0(VI02)
        NOP                                 lq            VF06,1(VI02)
        NOP                                 iaddiu        VI11,VI02,2
        NOP                                 iadd          VI03,VI11,VI10
        NOP                                 ibeq          VI12,VI00,matInBatch
        NOP                                 NOP
        NOP                                 iadd          VI11,VI12,VI00
matInBatch:
        NOP                                 iadd          VI08,VI03,VI13
        NOP                                 iadd          VI04,VI08,VI13
        NOP                                 iadd          VI05,VI04,VI07
        NOP                                 iadd          VI06,VI05,VI00
        NOP                                 sqi           VF06,(VI06++)
        NOP                                 iadd          VI07,VI02,VI07
        NOP                                 iaddiu        VI10,VI00,0x80
vertexLoop:
        NOP                                 lq            VF08,0(VI04)
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 mtir          VI12,VF08w
        NOP                                 iadd          VI13,VI03,VI12
        NOP                                 iadd          VI12,VI08,VI12
        NOP                                 lq            VF07,0(VI13)
        NOP                                 lq            VF09,0(VI12)
        NOP                                 NOP
        NOP                                 NOP
        itof0.xyz     VF07,VF07             mtir          VI09,VF07w
        NOP                                 iadd          VI09,VI09,VI11
        NOP                                 lq            VF01,0(VI09)
        NOP                                 lq            VF02,1(VI09)
        NOP                                 lq            VF03,2(VI09)
        NOP                                 lq            VF04,3(VI09)
        NOP                                 mfir.w        VF08,VI10
        NOP                                 NOP
        mulax         ACC,VF01,VF07x        NOP
        madday        ACC,VF02,VF07y        NOP
        maddaz        ACC,VF03,VF07z        NOP
        maddw         VF07,VF04,VF00w       NOP
        itof12        VF09,VF09             NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        mulax         ACC,VF10,VF09x        NOP
        madday        ACC,VF11,VF09y        NOP
        maddw         VF09,VF12,VF00w       NOP
        NOP                                 NOP
        NOP                                 NOP
        clipw.xyz     VF07xyz,VF07w         div           Q,VF00w,VF07w
        addw.z        VF09,VF00,VF00w       waitq
        mulq.xyz      VF07,VF07,Q           NOP
        mulq.xyz      VF09,VF09,Q           NOP
        NOP                                 NOP
        NOP                                 NOP
        mulaw.xyz     ACC,VF05,VF00w        NOP
        madd.xyz      VF07,VF07,VF05        NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        ftoi4.xyz     VF07,VF07             fcand         VI01,262143
        NOP                                 iaddiu        VI01,VI01,0x00007fff
        NOP                                 sq            VF09,0(VI06)
        NOP                                 sq            VF08,1(VI06)
        NOP                                 NOP
        NOP                                 sq.xyz        VF07,2(VI06)
        NOP                                 isw.w         VI01,2(VI06)
        NOP                                 iaddiu        VI04,VI04,1
        NOP                                 iaddiu        VI06,VI06,3
        NOP                                 isubiu        VI07,VI07,1
        NOP                                 ibne          VI07,VI02,vertexLoop
        NOP                                 NOP
        NOP                                 xgkick        VI05
        NOP[E]                              NOP
        NOP                                 NOP
; lit batches: the normals between the UVs and the colours (VI14), the light matrix after the transform (VI09 + 4)
VU1Lit_Start:
        NOP                                 lq.xyz        VF05,0(VI00)
        NOP                                 lq            VF10,8(VI00)
        NOP                                 lq            VF11,9(VI00)
        NOP                                 lq            VF12,10(VI00)
        NOP                                 lq            VF19,11(VI00)
        NOP                                 lq            VF20,12(VI00)
        NOP                                 lq            VF18,13(VI00)
        NOP                                 lq            VF23,14(VI00)
        NOP                                 xtop          VI02
        NOP                                 fcset         0
        NOP                                 ilw.x         VI07,0(VI02)
        NOP                                 ilw.y         VI10,0(VI02)
        NOP                                 ilw.z         VI12,0(VI02)
        NOP                                 ilw.w         VI13,0(VI02)
        NOP                                 lq            VF06,1(VI02)
        NOP                                 iaddiu        VI11,VI02,2
        NOP                                 iadd          VI03,VI11,VI10
        NOP                                 ibeq          VI12,VI00,litMatInBatch
        NOP                                 NOP
        NOP                                 iadd          VI11,VI12,VI00
litMatInBatch:
        NOP                                 iadd          VI08,VI03,VI13
        NOP                                 iadd          VI14,VI08,VI13
        NOP                                 iadd          VI04,VI14,VI13
        NOP                                 iadd          VI05,VI04,VI07
        NOP                                 iadd          VI06,VI05,VI00
        NOP                                 sqi           VF06,(VI06++)
        NOP                                 iadd          VI07,VI02,VI07
        NOP                                 iaddiu        VI10,VI00,0x80
litLoop:
        NOP                                 lq            VF08,0(VI04)
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 mtir          VI12,VF08w
        NOP                                 iadd          VI13,VI03,VI12
        NOP                                 iadd          VI15,VI14,VI12
        NOP                                 iadd          VI12,VI08,VI12
        NOP                                 lq            VF07,0(VI13)
        NOP                                 lq            VF09,0(VI12)
        NOP                                 lq            VF13,0(VI15)
        NOP                                 NOP
        itof0.xyz     VF07,VF07             mtir          VI09,VF07w
        itof0.xyz     VF13,VF13             iadd          VI09,VI09,VI11
        itof0.xyz     VF22,VF08             lq            VF01,0(VI09)
        NOP                                 lq            VF02,1(VI09)
        NOP                                 lq            VF03,2(VI09)
        NOP                                 lq            VF04,3(VI09)
        NOP                                 lq            VF14,4(VI09)
        NOP                                 lq            VF15,5(VI09)
        NOP                                 lq            VF16,6(VI09)
        mulax         ACC,VF01,VF07x        NOP
        madday        ACC,VF02,VF07y        NOP
        maddaz        ACC,VF03,VF07z        NOP
        maddw         VF07,VF04,VF00w       NOP
        mulax.xy      ACC,VF14,VF13x        NOP
        madday.xy     ACC,VF15,VF13y        NOP
        maddz.xy      VF17,VF16,VF13z       NOP
        itof12        VF09,VF09             NOP
        NOP                                 NOP
        NOP                                 NOP
        max.xy        VF17,VF17,VF00        NOP
        mulax         ACC,VF10,VF09x        NOP
        madday        ACC,VF11,VF09y        NOP
        maddw         VF09,VF12,VF00w       NOP
        mulaw.xyz     ACC,VF18,VF00w        NOP
        maddax.xyz    ACC,VF19,VF17x        NOP
        maddy.xyz     VF21,VF20,VF17y       NOP
        clipw.xyz     VF07xyz,VF07w         div           Q,VF00w,VF07w
        addw.z        VF09,VF00,VF00w       waitq
        mulq.xyz      VF07,VF07,Q           NOP
        mulq.xyz      VF09,VF09,Q           NOP
        minix.xyz     VF21,VF21,VF23x       NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        mul.xyz       VF22,VF22,VF21        NOP
        mulaw.xyz     ACC,VF05,VF00w        NOP
        madd.xyz      VF07,VF07,VF05        NOP
        NOP                                 NOP
        miniw.xyz     VF22,VF22,VF23w       NOP
        NOP                                 NOP
        NOP                                 NOP
        ftoi4.xyz     VF07,VF07             fcand         VI01,262143
        ftoi0.xyz     VF22,VF22             iaddiu        VI01,VI01,0x00007fff
        NOP                                 sq            VF09,0(VI06)
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 mfir.w        VF22,VI10
        NOP                                 sq.xyz        VF07,2(VI06)
        NOP                                 isw.w         VI01,2(VI06)
        NOP                                 sq            VF22,1(VI06)
        NOP                                 iaddiu        VI04,VI04,1
        NOP                                 iaddiu        VI06,VI06,3
        NOP                                 isubiu        VI07,VI07,1
        NOP                                 ibne          VI07,VI02,litLoop
        NOP                                 NOP
        NOP                                 xgkick        VI05
        NOP[E]                              NOP
        NOP                                 NOP
VU1Env_Start:
        NOP                                 lq.xyz        VF05,0(VI00)
        NOP                                 lq            VF10,8(VI00)
        NOP                                 lq            VF11,9(VI00)
        NOP                                 lq            VF12,10(VI00)
        NOP                                 lq            VF24,15(VI00)
        NOP                                 xtop          VI02
        NOP                                 fcset         0
        NOP                                 ilw.x         VI07,0(VI02)
        NOP                                 ilw.y         VI10,0(VI02)
        NOP                                 ilw.z         VI12,0(VI02)
        NOP                                 ilw.w         VI13,0(VI02)
        NOP                                 lq            VF06,1(VI02)
        NOP                                 iaddiu        VI11,VI02,2
        NOP                                 iadd          VI03,VI11,VI10
        NOP                                 ibeq          VI12,VI00,envMatInBatch
        NOP                                 NOP
        NOP                                 iadd          VI11,VI12,VI00
envMatInBatch:
        NOP                                 iadd          VI08,VI03,VI13
        NOP                                 iadd          VI14,VI08,VI13
        NOP                                 iadd          VI04,VI14,VI13
        NOP                                 iadd          VI05,VI04,VI07
        NOP                                 iadd          VI06,VI05,VI00
        NOP                                 sqi           VF06,(VI06++)
        NOP                                 iadd          VI07,VI02,VI07
        NOP                                 iaddiu        VI10,VI00,0x80
envLoop:
        NOP                                 lq            VF08,0(VI04)
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 mtir          VI12,VF08w
        NOP                                 iadd          VI13,VI03,VI12
        NOP                                 iadd          VI15,VI14,VI12
        NOP                                 lq            VF07,0(VI13)
        NOP                                 lq            VF13,0(VI15)
        NOP                                 NOP
        NOP                                 NOP
        itof0.xyz     VF07,VF07             mtir          VI09,VF07w
        itof0.xyz     VF13,VF13             iadd          VI09,VI09,VI11
        NOP                                 lq            VF01,0(VI09)
        NOP                                 lq            VF02,1(VI09)
        NOP                                 lq            VF03,2(VI09)
        NOP                                 lq            VF04,3(VI09)
        NOP                                 mfir.w        VF08,VI10
        mulax         ACC,VF01,VF07x        NOP
        madday        ACC,VF02,VF07y        NOP
        maddaz        ACC,VF03,VF07z        NOP
        maddw         VF07,VF04,VF00w       NOP
        mulax         ACC,VF01,VF13x        NOP
        madday        ACC,VF02,VF13y        NOP
        maddz         VF17,VF03,VF13z       NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        mulax.xyz     ACC,VF10,VF17x        NOP
        madday.xyz    ACC,VF11,VF17y        NOP
        maddaw.xyz    ACC,VF12,VF17w        NOP
        maddw.xyz     VF09,VF24,VF00w       NOP
        clipw.xyz     VF07xyz,VF07w         div           Q,VF00w,VF07w
        NOP                                 waitq
        mulq.xyz      VF07,VF07,Q           NOP
        mulq.xyz      VF09,VF09,Q           NOP
        NOP                                 NOP
        NOP                                 NOP
        mulaw.xyz     ACC,VF05,VF00w        NOP
        madd.xyz      VF07,VF07,VF05        NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        ftoi4.xyz     VF07,VF07             fcand         VI01,262143
        NOP                                 iaddiu        VI01,VI01,0x00007fff
        NOP                                 sq            VF09,0(VI06)
        NOP                                 sq            VF08,1(VI06)
        NOP                                 NOP
        NOP                                 sq.xyz        VF07,2(VI06)
        NOP                                 isw.w         VI01,2(VI06)
        NOP                                 iaddiu        VI04,VI04,1
        NOP                                 iaddiu        VI06,VI06,3
        NOP                                 isubiu        VI07,VI07,1
        NOP                                 ibne          VI07,VI02,envLoop
        NOP                                 NOP
        NOP                                 xgkick        VI05
        NOP[E]                              NOP
        NOP                                 NOP
; Static strips (VU1Strip, render.c STRIP_PROGRAM): unlit groups of models without a skeleton, as triangle strips
; (tools/slice.py strip_batches). No index: the vertices come in emission order at fixed places, so one pointer walks
; the three arrays, and four vertices run interleaved per loop (both pipes busy instead of one vertex's latencies).
; batch at TOP  : +0 int x = vertex count n (a multiple of 4, <= 80); +1 GIF tag (TRIANGLE_STRIP, NLOOP = n)
;                 +2 .. +81   positions (s32 x, y, z, w: UNPACK V4-16 signed; w = -32768 starts a strip: ADC on)
;                 +82 .. +161 UVs (UNPACK V2-16 signed, 12 fraction bits; unwritten if untextured)
;                 +162 .. +241 colours (UNPACK V4-8 unsigned, alpha 0x80 in the data)
; output        : +242 GIF tag, then ST, RGBAQ, XYZ2 per vertex (+243 .. +482), XGKICKed.
; The matrix is the static instance's (VU mem 1..4). Guard band: CF holds the last four clip judgements, so after
; two clipw the triangles of both vertices are read with two masks (bits 6-23: the older one's, 0-17: the newer's).
        .global VU1Strip_Start
VU1Strip_Start:
        NOP                                 lq.xyz        VF05,0(VI00)
        NOP                                 lq            VF01,1(VI00)
        NOP                                 lq            VF02,2(VI00)
        NOP                                 lq            VF03,3(VI00)
        NOP                                 lq            VF04,4(VI00)
        NOP                                 lq            VF10,8(VI00)
        NOP                                 lq            VF11,9(VI00)
        NOP                                 lq            VF12,10(VI00)
        NOP                                 xtop          VI02
        NOP                                 iaddiu        VI12,VI00,0x7fff
        NOP                                 ilw.x         VI07,0(VI02)
        NOP                                 lq            VF06,1(VI02)
        NOP                                 iaddiu        VI04,VI02,2
        NOP                                 iaddiu        VI05,VI02,242
        NOP                                 iaddiu        VI06,VI02,243
        NOP                                 sq            VF06,0(VI05)
        NOP                                 iadd          VI07,VI07,VI04
stripLoop:
        NOP                                 lq            VF07,0(VI04)
        NOP                                 lq            VF09,80(VI04)
        NOP                                 lq            VF13,1(VI04)
        NOP                                 lq            VF15,81(VI04)
        itof0.xyz     VF07,VF07             lq            VF16,2(VI04)
        itof12        VF09,VF09             lq            VF18,82(VI04)
        itof0.xyz     VF13,VF13             lq            VF19,3(VI04)
        itof12        VF15,VF15             lq            VF21,83(VI04)
        mulax         ACC,VF01,VF07x        ilw.w         VI08,0(VI04)
        madday        ACC,VF02,VF07y        ilw.w         VI09,1(VI04)
        maddaz        ACC,VF03,VF07z        ilw.w         VI10,2(VI04)
        maddw         VF07,VF04,VF00w       ilw.w         VI11,3(VI04)
        mulax         ACC,VF01,VF13x        lq            VF08,160(VI04)
        madday        ACC,VF02,VF13y        lq            VF14,161(VI04)
        maddaz        ACC,VF03,VF13z        lq            VF17,162(VI04)
        maddw         VF13,VF04,VF00w       lq            VF20,163(VI04)
        mulax         ACC,VF10,VF09x        div           Q,VF00w,VF07w
        madday        ACC,VF11,VF09y        NOP
        maddw         VF09,VF12,VF00w       NOP
        clipw.xyz     VF07xyz,VF07w         NOP
        clipw.xyz     VF13xyz,VF13w         NOP
        mulax         ACC,VF10,VF15x        NOP
        madday        ACC,VF11,VF15y        waitq
        maddw         VF15,VF12,VF00w       NOP
        addw.z        VF09,VF00,VF00w       NOP
        mulq.xyz      VF07,VF07,Q           fcand         VI01,16777152
        itof0.xyz     VF16,VF16             iadd          VI01,VI01,VI12
        itof12        VF18,VF18             ior           VI08,VI08,VI01
        mulq.xyz      VF09,VF09,Q           div           Q,VF00w,VF13w
        mulaw.xyz     ACC,VF05,VF00w        fcand         VI01,262143
        madd.xyz      VF07,VF07,VF05        iadd          VI01,VI01,VI12
        addw.z        VF15,VF00,VF00w       ior           VI09,VI09,VI01
        itof0.xyz     VF19,VF19             sq            VF09,0(VI06)
        itof12        VF21,VF21             sq            VF08,1(VI06)
        mulax         ACC,VF01,VF16x        isw.w         VI08,2(VI06)
        madday        ACC,VF02,VF16y        NOP
        maddaz        ACC,VF03,VF16z        waitq
        maddw         VF16,VF04,VF00w       NOP
        ftoi4.xyz     VF07,VF07             NOP
        mulq.xyz      VF13,VF13,Q           NOP
        mulq.xyz      VF15,VF15,Q           NOP
        mulax         ACC,VF01,VF19x        NOP
        madday        ACC,VF02,VF19y        sq.xyz        VF07,2(VI06)
        maddaz        ACC,VF03,VF19z        div           Q,VF00w,VF16w
        maddw         VF19,VF04,VF00w       sq            VF15,3(VI06)
        mulaw.xyz     ACC,VF05,VF00w        sq            VF14,4(VI06)
        madd.xyz      VF13,VF13,VF05        isw.w         VI09,5(VI06)
        mulax         ACC,VF10,VF18x        NOP
        madday        ACC,VF11,VF18y        NOP
        maddw         VF18,VF12,VF00w       NOP
        ftoi4.xyz     VF13,VF13             NOP
        clipw.xyz     VF16xyz,VF16w         NOP
        clipw.xyz     VF19xyz,VF19w         NOP
        mulax         ACC,VF10,VF21x        waitq
        madday        ACC,VF11,VF21y        sq.xyz        VF13,5(VI06)
        maddw         VF21,VF12,VF00w       NOP
        addw.z        VF18,VF00,VF00w       NOP
        mulq.xyz      VF16,VF16,Q           fcand         VI01,16777152
        NOP                                 iadd          VI01,VI01,VI12
        NOP                                 ior           VI10,VI10,VI01
        mulq.xyz      VF18,VF18,Q           div           Q,VF00w,VF19w
        mulaw.xyz     ACC,VF05,VF00w        fcand         VI01,262143
        madd.xyz      VF16,VF16,VF05        iadd          VI01,VI01,VI12
        addw.z        VF21,VF00,VF00w       ior           VI11,VI11,VI01
        NOP                                 sq            VF18,6(VI06)
        NOP                                 sq            VF17,7(VI06)
        ftoi4.xyz     VF16,VF16             isw.w         VI10,8(VI06)
        NOP                                 waitq
        mulq.xyz      VF19,VF19,Q           NOP
        mulq.xyz      VF21,VF21,Q           NOP
        NOP                                 NOP
        NOP                                 sq.xyz        VF16,8(VI06)
        mulaw.xyz     ACC,VF05,VF00w        sq            VF21,9(VI06)
        madd.xyz      VF19,VF19,VF05        sq            VF20,10(VI06)
        NOP                                 isw.w         VI11,11(VI06)
        NOP                                 iaddiu        VI04,VI04,4
        NOP                                 NOP
        ftoi4.xyz     VF19,VF19             NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 NOP
        NOP                                 sq.xyz        VF19,11(VI06)
        NOP                                 ibne          VI04,VI07,stripLoop
        NOP                                 iaddiu        VI06,VI06,12
        NOP                                 xgkick        VI05
        NOP[E]                              NOP
        NOP                                 NOP
; Skinned lit strips (VU1SkinLit, render.c SKINLIT_PROGRAM): lit groups of skinned models as triangle strips, each
; vertex with its own matrix (w = 7 x slot, bit 15 starts a strip), two vertices interleaved per loop. Lighting as
; VU1Lit: colour x min(ambient + sum max(0, n . l) colour, 2), at most 255.
; batch at TOP  : +0 int x = vertex count n (a multiple of 4, <= 60); +1 GIF tag (TRIANGLE_STRIP, NLOOP = n)
;                 +2 .. +71   m <= 10 matrices (4 columns local -> clip, then the light matrix's 3)
;                 +72 .. +131 positions (UNPACK V4-16 signed), +132 .. +191 UVs (V2-16 signed),
;                 +192 .. +251 normals (V4-8 signed, x 127), +252 .. +311 colours (V4-8 unsigned, alpha 0x80)
; output        : +312 GIF tag, then ST, RGBAQ, XYZ2 per vertex (+313 .. +492), XGKICKed.
        .global VU1SkinLit_Start
VU1SkinLit_Start:
